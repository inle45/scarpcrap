# ─────────────────────────────────────────────────────────────
#  scarpcrap — configuration
#  Copier en `.env` et remplir. Aucune cle n'est obligatoire :
#  sans cle, le connecteur correspondant est simplement desactive.
# ─────────────────────────────────────────────────────────────

# ── Serveur ──────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Jeton d'acces au dashboard. Le dashboard est mono-utilisateur :
# ce jeton est demande une fois puis garde dans le navigateur.
# GENERE-EN UN : openssl rand -hex 32
AUTH_TOKEN=change-moi-openssl-rand-hex-32

# Base SQLite (chemin dans le conteneur / sur disque)
DATABASE_PATH=./data/scarpcrap.db

# ── Marche ───────────────────────────────────────────────────
MARKET_COUNTRY=FR
MARKET_CURRENCY=EUR

# ── Planification ────────────────────────────────────────────
# Cron du scraping. Defaut : toutes les 3 heures.
# Mets SCHEDULE_ENABLED=false pour ne lancer qu'a la main.
SCHEDULE_ENABLED=true
SCHEDULE_CRON=17 */3 * * *
SCHEDULE_TIMEZONE=Europe/Paris
# Lancer un cycle immediatement au demarrage du process
RUN_ON_BOOT=false

# ── Seuils (surchargables a chaud depuis le dashboard) ───────
MIN_TRUST_SCORE=70
MIN_ROI_PCT=25
MIN_NET_PROFIT_EUR=8
# Seuils specifiques a l'alerte montre (plus stricts que l'affichage)
ALERT_MIN_TRUST_SCORE=80
ALERT_MIN_ROI_PER_DAY_EUR=1.5
ALERT_MAX_PER_RUN=5

# ── Alertes ntfy.sh (montre Pixel Watch via notif Android) ───
# Choisis un topic long et imprevisible : sur ntfy.sh public,
# le topic EST le mot de passe. Ex: scarpcrap-9f2a7c1b4e8d
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# Optionnel, si tu utilises un serveur ntfy protege
NTFY_TOKEN=

# ── eBay Browse API (officielle, gratuite) ───────────────────
# https://developer.ebay.com/ -> My Account -> Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace d'achat, et marketplaces utilises pour les comparaisons
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_COMP_MARKETPLACES=EBAY_FR,EBAY_DE
# Budget d'appels par cycle (quota gratuit : 5000/jour toutes API confondues)
EBAY_MAX_CALLS_PER_RUN=250

# ── Discogs API (officielle, gratuite) ───────────────────────
# https://www.discogs.com/settings/developers -> Generate token
DISCOGS_TOKEN=
DISCOGS_MAX_CALLS_PER_RUN=120

# ── BrickLink API (officielle, gratuite) ─────────────────────
# https://www.bricklink.com/v2/api/register_consumer.page
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=
BRICKLINK_MAX_CALLS_PER_RUN=120

# ── Reglage fin du pipeline ──────────────────────────────────
# Nombre d'annonces enrichies par cycle (1 appel API chacune).
MAX_ENRICH_PER_RUN=25
# Delai avant de reevaluer une annonce deja vue (heures).
REEVALUATE_AFTER_HOURS=12
# Age au-dela duquel une annonce non tranchee est purgee (jours).
PRUNE_AFTER_DAYS=30
# Plafond d'annonces evaluees par cycle, toutes sources confondues.
MAX_LISTINGS_PER_RUN=300

# ── Divers ───────────────────────────────────────────────────
# URL publique du dashboard, incluse dans les notifications.
PUBLIC_URL=
# debug | info | warn | error
LOG_LEVEL=info
# Mets true uniquement si un reverse proxy de confiance est devant.
TRUST_PROXY=false
# Chemins des fichiers de configuration (voir config/README.md).
HUNTS_FILE=./config/hunts.json
FEES_FILE=./config/fees.json
# User-Agent envoye aux API. Discogs exige un agent identifiable.
USER_AGENT=scarpcrap/0.1 (+https://github.com/inle45/scarpcrap)
# Bascule vers l'environnement bac a sable d'eBay.
EBAY_SANDBOX=false

# ── Mode demo ────────────────────────────────────────────────
# true = genere des annonces fictives pour voir le dashboard vivre
# sans aucune cle API. A desactiver en production.
DEMO_MODE=false
