{
  "name": "scarpcrap",
  "version": "0.1.0",
  "private": true,
  "description": "Bot d'arbitrage omnicanal semi-automatise — trouve des annonces sous-evaluees, estime la revente, calcule le ROI/jour et alerte sur la montre.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "npm run build && node --env-file-if-exists=.env dist/src/index.js",
    "run:once": "npm run build && node --env-file-if-exists=.env dist/src/cli/runOnce.js",
    "seed:demo": "npm run build && node --env-file-if-exists=.env dist/src/cli/seedDemo.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.4.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
